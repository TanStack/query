import type {
  Accessor,
  CreateQueriesOptions,
  CreateQueriesResult,
  QueryClient,
  QueryObserverResult,
  RefetchOptions,
} from "@tanstack/marko-query";
import {
  QueriesBinding,
  holdClient,
  onPageClientChange,
  readQueries,
  resolveClient,
  toPlainResult,
} from "@tanstack/marko-query/internal";
import type { ClientHold } from "@tanstack/marko-query/internal";

export interface Input<T extends Array<any>, TCombined = never> {
  /**
   * `{ queries, combine? }`. A function, so the tag follows the values it
   * reads.
   */
  options: Accessor<CreateQueriesOptions<T, TCombined>>;
  /** The client to use instead of the one for this `$global`. */
  client?: Accessor<QueryClient>;
}

static function raise(error: unknown): never {
  throw error;
}

// `combine` is called here rather than kept in a tag variable: it is created
// by the `options` accessor, so Marko could not serialize it.
static function combineResults(
  combine: ((results: never) => unknown) | undefined,
  results: unknown,
): unknown {
  return combine ? combine(results as never) : results;
}

static function queriesOf(options: CreateQueriesOptions<any, any>) {
  return {
    queries: options.queries as never,
    subscribed: options.subscribed,
  };
}

<const/snapshot=readQueries(
  resolveClient($global, input.client),
  queriesOf(input.options()),
)>
<let/results=(snapshot.result as QueryObserverResult[])>
<let/thrown=snapshot.thrown>
<const/holder={hold: {} as ClientHold, hydrated: false} as {
  binding?: QueriesBinding;
  unwatch?: () => void;
  hold: ClientHold;
  hydrated: boolean;
}>
<const/connect=(() => {
  if (holder.binding) return holder.binding;
  holder.binding = new QueriesBinding(
    resolveClient($global, input.client),
    queriesOf(input.options()),
    (next, error) => {
      results = next.results.map(toPlainResult);
      thrown = error;
    },
    // The snapshot belongs to the render that made it. A binding built later,
    // for a client that replaced the page's client, must not seed that client
    // with the server's entries.
    holder.hydrated ? undefined : snapshot.hydration,
  );
  holder.hydrated = true;
  return holder.binding;
})>

<lifecycle
  onMount() {
    holdClient(holder.hold, connect().client, !!input.client);
    holder.unwatch = onPageClientChange(
      () => {
        holder.binding?.destroy();
        holder.binding = undefined;
        holdClient(holder.hold, connect().client, !!input.client);
      },
      () => !input.client,
    );
  }
  onUpdate() {
    const client = resolveClient($global, input.client);
    if (holder.binding && holder.binding.client !== client) {
      holder.binding.destroy();
      holder.binding = undefined;
    }
    holdClient(holder.hold, connect().client, !!input.client);
    connect().setOptions(queriesOf(input.options()));
  }
  onDestroy() {
    holder.unwatch?.();
    holder.binding?.destroy();
    holdClient(holder.hold, undefined, false);
  }
/>

<if=thrown>${raise(thrown.error)}</if>

<const/withMethods=(results.map((result, index) => ({
  ...result,
  refetch: (options?: RefetchOptions) =>
    connect().observer.getObservers()[index]!.refetch(options),
})) as QueryObserverResult[])>
<return=(combineResults(
  input.options().combine as ((results: never) => unknown) | undefined,
  withMethods,
) as CreateQueriesResult<T, TCombined>)>
