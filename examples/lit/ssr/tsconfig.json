{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "useDefineForClassFields": false,
    "checkJs": true
  },
  "include": ["src", "server.js", "*.config.ts", "*.config.js"]
}
