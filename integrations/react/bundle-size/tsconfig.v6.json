{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#adapter": ["./node_modules/@tanstack/react-query"],
      "#query-hooks": ["./src/v6-query.ts"],
      "#feature-options": ["./src/v6-options.ts"],
      "#polling-option": ["./src/numeric-interval.ts"],
      "#screen": ["./src/screen-types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/pluggable-*.ts"]
}
