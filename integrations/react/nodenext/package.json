{
  "name": "@tanstack/query-integration-react-nodenext",
  "private": true,
  "type": "module",
  "scripts": {
    "test:types": "pnpm run test:types:ts6 && pnpm run test:types:ts7 && pnpm run test:types:ts71",
    "test:types:ts6": "node ../../../node_modules/typescript/lib/tsc.js --pretty false --project tsconfig.json",
    "test:types:ts7": "node ../../../node_modules/typescript70/lib/tsc.js --pretty false --project tsconfig.json",
    "test:types:ts71": "node ../../../node_modules/typescript71/lib/tsc.js --pretty false --project tsconfig.json"
  },
  "dependencies": {
    "@tanstack/query-core": "workspace:*",
    "@tanstack/react-query": "workspace:*",
    "@tanstack/react-query-pluggable": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  },
  "nx": {
    "targets": {
      "test:types": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
