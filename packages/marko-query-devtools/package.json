{
  "name": "@tanstack/marko-query-devtools",
  "version": "0.0.0",
  "description": "Developer tools to interact with and visualize the TanStack Query cache in Marko",
  "author": "Behzad Barzin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/query.git",
    "directory": "packages/marko-query-devtools"
  },
  "homepage": "https://tanstack.com/query",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "query",
    "marko",
    "devtools"
  ],
  "scripts": {
    "clean": "premove ./dist ./coverage ./dist-ts ./.cache/test-types",
    "compile": "tsc --project tsconfig.json",
    "test:oxlint": "oxlint ./src ./tests",
    "test:types": "npm-run-all --serial test:types:*",
    "test:types:ts57": "node ../../node_modules/typescript57/lib/tsc.js --project tsconfig.legacy.json --outDir .cache/test-types/ts57 --tsBuildInfoFile .cache/test-types/ts57.tsbuildinfo",
    "test:types:ts58": "node ../../node_modules/typescript58/lib/tsc.js --project tsconfig.legacy.json --outDir .cache/test-types/ts58 --tsBuildInfoFile .cache/test-types/ts58.tsbuildinfo",
    "test:types:ts59": "node ../../node_modules/typescript59/lib/tsc.js --project tsconfig.legacy.json --outDir .cache/test-types/ts59 --tsBuildInfoFile .cache/test-types/ts59.tsbuildinfo",
    "test:types:tscurrent": "marko-type-check --project tsconfig.typecheck.json",
    "test:types:ts70": "node ../../node_modules/typescript70/lib/tsc.js --project tsconfig.legacy.json --outDir .cache/test-types/ts70 --tsBuildInfoFile .cache/test-types/ts70.tsbuildinfo",
    "test:types:ts71": "node ../../node_modules/typescript71/lib/tsc.js --project tsconfig.legacy.json --outDir .cache/test-types/ts71 --tsBuildInfoFile .cache/test-types/ts71.tsbuildinfo",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm run test:lib --watch",
    "test:build": "publint --strict && attw --pack",
    "build": "premove ./dist && marko-type-check --project tsconfig.prod.json && premove ./dist/.tsbuildinfo"
  },
  "nx": {
    "targets": {
      "test:lib": {
        "dependsOn": [
          "^compile",
          "build"
        ]
      },
      "test:types": {
        "dependsOn": [
          "^compile",
          "^build",
          "build"
        ]
      }
    }
  },
  "type": "module",
  "exports": {
    "./production/*": "./dist/production/*",
    "./marko.json": "./marko.json",
    "./dist/tags/*": "./dist/tags/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.marko"
  ],
  "files": [
    "dist",
    "src",
    "marko.json"
  ],
  "dependencies": {
    "@tanstack/query-devtools": "workspace:*"
  },
  "devDependencies": {
    "@marko/type-check": "catalog:",
    "@marko/vite": "catalog:",
    "@tanstack/marko-query": "workspace:*",
    "marko": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/marko-query": "workspace:^",
    "marko": "^6.0.0"
  }
}
