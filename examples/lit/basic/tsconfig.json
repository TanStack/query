{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "config/port.js", "*.config.ts", "*.config.js"]
}
