import type { Accessor, QueryClient } from "@tanstack/marko-query";
import { registerQueryClientFactory } from "@tanstack/marko-query/internal";

export interface Input {
  /**
   * Creates every `QueryClient` of the app: one per request on the server and
   * one per page in the browser. Must be a function you `import`.
   */
  factory: Accessor<QueryClient>;
}

// `transform/query-client-factory.cjs` registers the factory at module scope,
// in both realms, so it is in effect before any route handler, render or mount.
// That registration is what makes the tag work, and it is why the tag reads
// `input.factory`: Marko only sends a tag's input to the browser when the tag
// uses it. This hook registers the same factory again, in the browser only, so
// a host that renders the tag without the transform still gets it. Seeing the
// factory twice is harmless.
<lifecycle
  onMount() {
    registerQueryClientFactory(input.factory);
  }
/>
