import { dehydrate, getQueryClient } from '@tanstack/marko-query'
import { todoPageQueryOptions } from '../../lib/queries.ts'

<const/client=getQueryClient($global)>
<const/ready=client.query(todoPageQueryOptions(1))>

<page-header
  title="Hydration"
  subtitle="The page prefetches, dehydrates by hand, and hands the state to hydration-boundary. The boundary hydrates the client before the tag reads it."
/>

<await|_|=ready>
  <const/state=dehydrate(client)>
  <hydration-boundary state=state>
    <query/todos options=() => todoPageQueryOptions(1)/>
    <if=todos.data>
      <todo-list todos=todos.data.todos/>
    </if>
    <else-if=todos.error>
      <p class="error">${todos.error.message}</p>
    </else-if>
  </hydration-boundary>
</await>

<p class="muted">
  The await above already filled the request client, so the tag would find the
  data even without the boundary. The boundary is for state that arrives outside
  the render: a loader, a second request, or a cache filled by hand.
</p>
