{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "useDefineForClassFields": false
  },
  "include": [
    "config/**/*.d.ts",
    "src/**/*.ts",
    "config/ports.js",
    "scripts/dev.mjs",
    "server/index.mjs",
    "*.config.ts",
    "*.config.js"
  ]
}
